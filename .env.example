# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored — never commit real tokens or passwords.

# ---- Plex ----
# Container name if on the same Docker network (http://plex:32400),
# or the host IP if Plex runs outside Docker / on host networking.
PLEX_URL=http://plex:32400
# https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# ---- qBittorrent ----
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbt_password_here

# ---- Behaviour ----
# Seconds between Plex polls (webhooks are the fast path; this is the fallback).
POLLING_INTERVAL=5
# Minimum seconds between alternative-speed toggles.
DEBOUNCE_SECONDS=3
# Grace period after a stream stops / disappears before alt speeds are turned off.
STOP_DELAY_SECONDS=30
# Grace period after a pause or buffer before alt speeds are turned off.
PAUSE_BUFFER_DELAY_SECONDS=60

# ---- Service ----
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
HTTP_PORT=5252
