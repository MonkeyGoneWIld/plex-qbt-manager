# cp .env.example .env  — .env is gitignored, never commit real credentials.

# Container names work if Plex/qBittorrent share a Docker network with this
# container; otherwise use the host IP, e.g. http://192.168.1.25:32400
PLEX_URL=http://plex:32400
PLEX_TOKEN=your_plex_token_here

QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbt_password_here

# Enable automatic upload budgeting from Plex's per-session bandwidth.
# Leave false to preserve existing toggle-only installations.
DYNAMIC_UPLOAD_ENABLED=false
# MiB/s (binary mebibytes/second); decimals are allowed. Minimum must be > 0.
MAX_UPLOAD_MIB=12
MIN_UPLOAD_MIB=1
# Multiplies the Plex bandwidth deduction, not the final upload limit.
BANDWIDTH_MULTIPLIER=1
# Hold the previous decision through brief Plex failures. After this many
# seconds without a successful poll, enable protective alternative limits
# (MIN_UPLOAD_MIB in dynamic mode) until Plex recovers.
PLEX_STALE_SECONDS=120

# Optional — these are the defaults
POLLING_INTERVAL=5
DEBOUNCE_SECONDS=3
STOP_DELAY_SECONDS=30
PAUSE_BUFFER_DELAY_SECONDS=60
# Read timeouts in seconds. Raise if a busy qBittorrent logs read timeouts.
PLEX_TIMEOUT=10
QBITTORRENT_TIMEOUT=10
# How often to re-read qBittorrent just to catch an externally-made change.
# Raise it further if qBittorrent is busy; speed changes we make are never
# delayed by it, so this only bounds how fast an external change is noticed.
DRIFT_CHECK_SECONDS=60
LOG_LEVEL=INFO
# Set LOG_LEVEL=DEBUG for per-poll session, timer, budget and API readback logs.
HTTP_PORT=5252
